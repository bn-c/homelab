#cloud-config
hostname: ${hostname}

users:
  - name: ${linux_user}
    groups: [sudo]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    lock_passwd: false

package_update: false
package_upgrade: false
packages:
  - curl
  - ca-certificates
  - git
  - qemu-guest-agent
  - cifs-utils
  - nfs-common

mounts:
  - ["nfs-nixos.local:/srv/nfs", "/root/nfs", "nfs", "defaults,_netdev", "0", "0"]

write_files:
  - path: /root/.ssh/id_rsa
    permissions: "0600"
    owner: root:root
    content: |
      -----BEGIN OPENSSH PRIVATE KEY-----
      b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMwAAAAtzc2gtZW
      QyNTUxOQAAACA/p4fDcJom+W5S6NVtq2sH4OG+lCpKzsIfUBftwEWUagAAAJBFfRJRRX0S
      UQAAAAtzc2gtZWQyNTUxOQAAACA/p4fDcJom+W5S6NVtq2sH4OG+lCpKzsIfUBftwEWUag
      AAAECTwcJjtY617ihvpBnJ+Bo6inMwk+0z2Buv/vKTxSsn9T+nh8Nwmib5blLo1W2rawfg
      4b6UKkrOwh9QF+3ARZRqAAAACXRlY2hAZGVzawECAwQ=
      -----END OPENSSH PRIVATE KEY-----

  - path: /opt/coder/init.sh
    permissions: "0755"
    owner: root:root
    encoding: b64
    content: |
      ${coder_init_script_b64}

  - path: /etc/systemd/system/coder-agent.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=Coder Agent
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=simple
      User=${linux_user}
      WorkingDirectory=/root
      Environment=HOME=/root
      Environment=CODER_AGENT_TOKEN=${coder_token}
      ExecStart=/opt/coder/init.sh
      OOMScoreAdjust=-1000
      Restart=always
      RestartSec=5

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl daemon-reload
  - systemctl enable --now qemu-guest-agent
  - systemctl enable --now coder-agent.service
  - mount -a

final_message: "Cloud-init complete on ${hostname}"
