# OpenTofu + Colmena via nix-direnv
use flake

# Load Proxmox secrets (gitignored)
dotenv_if_exists .env

# colmena auto-discovers flake.nix first; wrap so it defaults to hive.nix
watch_file hive.nix
_colmena_bin="$(direnv_layout_dir)/bin"
_colmena_real="$(command -v colmena)"
mkdir -p "$_colmena_bin"
cat > "$_colmena_bin/colmena" <<EOF
#!/usr/bin/env bash
set -euo pipefail
has_config=0
for arg in "\$@"; do
  case "\$arg" in
    -f|--config) has_config=1 ;;
  esac
done
if [[ "\$has_config" -eq 0 ]]; then
  exec "${_colmena_real}" -f "${PWD}/hive.nix" "\$@"
else
  exec "${_colmena_real}" "\$@"
fi
EOF
chmod +x "$_colmena_bin/colmena"
PATH_add "$_colmena_bin"
