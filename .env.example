# Proxmox credentials for OpenTofu (password auth)
# Copy to .env and fill in: cp .env.example .env
# Then: set -a && source .env && set +a

TF_VAR_proxmox_host=192.168.11.2
TF_VAR_proxmox_username=root@pam
TF_VAR_proxmox_password=YOUR_PROXMOX_PASSWORD
TF_VAR_proxmox_ssh_password=YOUR_PROXMOX_SSH_PASSWORD
